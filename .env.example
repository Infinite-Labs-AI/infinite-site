# Site build/runtime (public values; provision from the authenticated site-source artifact)
INFINITE_PRODUCTION_HOSTS=infinite.fast
INFINITE_SITE_SOURCE_KEY=

# Live synthetic guardrail (never use the production source key)
REQUIRE_SYNTHETIC_RECEIPTS=0
SYNTHETIC_SITE_SOURCE_KEY=
ANALYTICS_RECEIPT_URL=https://api.ultima.inc/api/analytics/diagnostics/receipt
ANALYTICS_RECEIPT_TOKEN=
SYNTHETIC_DRAIN_URL=https://api.ultima.inc/api/analytics/events/vercel-drain
SYNTHETIC_DRAIN_SECRET=
SYNTHETIC_VERCEL_PROJECT_ID=
SYNTHETIC_PRODUCTION_HOST=infinite.fast
