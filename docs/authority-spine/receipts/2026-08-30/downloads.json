  "required_sql": "select d.occurred_on, d.document_requests, d.server_visits,\n       d.download_attempts, d.download_attempt_visits, d.keyed_document_requests\nfrom public.analytics_site_daily d\njoin public.analytics_site_sources s\n  on s.id = d.site_source_id and s.workspace_id = d.workspace_id\nwhere d.environment = 'production'\n  and d.grain = 'total'\n  and 'infinite.fast' = any(s.production_hosts)\n  and d.occurred_on >= current_date - 27\norder by d.occurred_on;",
  "proof_sql": "with required_read as (\n  select d.occurred_on, d.document_requests, d.server_visits,\n         d.download_attempts, d.download_attempt_visits, d.keyed_document_requests\n  from public.analytics_site_daily d\n  join public.analytics_site_sources s\n    on s.id = d.site_source_id and s.workspace_id = d.workspace_id\n  where d.environment = 'production'\n    and d.grain = 'total'\n    and 'infinite.fast' = any(s.production_hosts)\n    and d.occurred_on >= current_date - 27\n)\nselect\n  'downloads' as receipt,\n  count(*)::bigint as row_count,\n  min(occurred_on)::text as first_date,\n  max(occurred_on)::text as last_date,\n  count(distinct occurred_on)::bigint as date_count,\n  coalesce(sum(document_requests), 0)::bigint as total_document_requests,\n  coalesce(sum(server_visits), 0)::bigint as total_server_visits,\n  coalesce(sum(download_attempts), 0)::bigint as total_download_attempts,\n  coalesce(sum(download_attempt_visits), 0)::bigint as total_download_attempt_visits,\n  coalesce(sum(keyed_document_requests), 0)::bigint as total_keyed_document_requests,\n  md5(coalesce(string_agg(to_jsonb(required_read)::text, E'\\n' order by occurred_on), '')) as rowset_md5\nfrom required_read;",
